.lesson-animation {
  width: 100%;
  min-height: 245px;
  padding: 18px;
  box-sizing: border-box;
  overflow: hidden;
  color: #f5f0ff;
  background:
    radial-gradient(ellipse at 50% 40%, #35205d 0%, transparent 65%),
    linear-gradient(135deg, #100d22, #211439 65%, #101b35);
  border: 1px solid #7250a5;
  border-radius: 13px;
  position: relative;
}

.la-heading {
  display: flex;
  align-items: center;
  gap: 8px;
  color: #8fead9;
  font-size: 9px;
  font-weight: 800;
  letter-spacing: 1.5px;
}

.la-live-dot {
  width: 7px;
  height: 7px;
  border-radius: 50%;
  background: #65f1d3;
  box-shadow: 0 0 12px #65f1d3;
  animation: laBlink 1.4s infinite alternate;
}

.la-step-count {
  margin-left: auto;
  color: #b9a8dd;
}

.lesson-animation h3 {
  margin: 13px 0 3px;
  font-size: clamp(15px, 2vw, 20px);
  color: #fff;
}

.la-subtitle {
  margin: 0;
  color: #a99bc8;
  font-size: 11px;
}

.la-stage {
  min-height: 125px;
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 12px 0;
}

.la-array {
  display: flex;
  flex-wrap: wrap;
  justify-content: center;
  gap: 8px;
  width: 100%;
}

.la-array-cell {
  min-width: 42px;
  min-height: 53px;
  display: flex;
  flex-direction: column;
  justify-content: center;
  align-items: center;
  gap: 5px;
  border: 1px solid #65518c;
  border-radius: 8px;
  background: #211a3b;
  transition: .35s ease;
}

.la-array-cell strong {
  color: #70eadc;
  font-size: 16px;
}

.la-array-cell small {
  color: #a99bc8;
  font-size: 9px;
}

.la-array-cell.active,
.la-node.active,
.la-linked-node.active,
.la-stack-item.active,
.la-hash-step.active,
.la-bar.active,
.la-vertex.active {
  border-color: #69f5d7;
  background: #344064;
  box-shadow: 0 0 19px #5df2d577;
  transform: translateY(-5px) scale(1.06);
  filter: brightness(1.25);
}

.la-flow {
  width: 100%;
  display: flex;
  justify-content: center;
  align-items: center;
  flex-wrap: wrap;
  gap: 5px;
}

.la-flow-item {
  display: flex;
  align-items: center;
  gap: 5px;
}

.la-node {
  padding: 12px 14px;
  border: 1px solid #66518e;
  border-radius: 9px;
  background: #211b3d;
  color: #eee6ff;
  font-size: 11px;
  transition: .35s ease;
}

.la-arrow {
  color: #72e9d6;
  font-size: 19px;
  font-weight: bold;
}

.la-linked {
  width: 100%;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 8px;
}

.la-linked-row {
  display: flex;
  justify-content: center;
  align-items: center;
  flex-wrap: wrap;
  gap: 5px;
}

.la-linked-group {
  display: flex;
  align-items: center;
  gap: 5px;
}

.la-linked-node {
  min-width: 42px;
  padding: 9px 6px;
  display: flex;
  flex-direction: column;
  align-items: center;
  border: 1px solid #695493;
  border-radius: 7px;
  background: #211b3d;
  transition: .35s ease;
}

.la-linked-node strong {
  color: #74eadb;
  font-size: 14px;
}

.la-linked-node small {
  color: #a99bc8;
  font-size: 8px;
}

.la-pointer {
  color: #c6a4ff;
  font-size: 9px;
  font-weight: bold;
  letter-spacing: 1px;
}

.la-null {
  color: #f6a5c6;
  font-size: 10px;
  font-weight: bold;
}

.la-stack-wrap {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 5px;
}

.la-stack-wrap > span {
  color: #c2b2e5;
  font-size: 9px;
  letter-spacing: 1px;
}

.la-stack {
  display: flex;
  flex-direction: column-reverse;
  gap: 4px;
  min-width: 100px;
  min-height: 90px;
  justify-content: flex-start;
  align-items: stretch;
  padding: 6px;
  border: 1px dashed #7d66a7;
  border-top: 0;
  border-radius: 0 0 8px 8px;
}

.la-queue .la-stack {
  flex-direction: row;
  align-items: center;
  min-height: 48px;
  min-width: 220px;
  border: 1px dashed #7d66a7;
  border-radius: 8px;
}

.la-stack-item {
  min-width: 65px;
  padding: 7px 12px;
  text-align: center;
  color: #79eadd;
  background: #292047;
  border: 1px solid #67518d;
  border-radius: 5px;
  font-size: 12px;
  transition: .35s ease;
}

.la-tree,
.la-graph {
  width: 100%;
  max-width: 430px;
}

.la-tree svg,
.la-graph svg {
  display: block;
  width: 100%;
  max-height: 180px;
  overflow: visible;
}

.la-edge {
  stroke: #7961a9;
  stroke-width: 2;
  opacity: .9;
}

.la-vertex {
  fill: #30204f;
  stroke: #9b79d1;
  stroke-width: 2;
  transition: .35s ease;
}

.la-vertex-label {
  fill: #fff;
  font-size: 12px;
  font-weight: bold;
}

.la-hash {
  display: flex;
  flex-wrap: wrap;
  justify-content: center;
  gap: 9px;
  width: 100%;
}

.la-hash-step {
  min-width: 72px;
  padding: 10px;
  display: flex;
  flex-direction: column;
  gap: 7px;
  text-align: center;
  background: #211b3d;
  border: 1px solid #66518e;
  border-radius: 8px;
  transition: .35s ease;
}

.la-hash-step span {
  color: #a99bc8;
  font-size: 9px;
}

.la-hash-step strong {
  color: #74eadb;
  font-size: 12px;
}

.la-chart {
  width: 100%;
  height: 120px;
  display: flex;
  align-items: end;
  justify-content: center;
  gap: 12px;
}

.la-bar-wrap {
  height: 100%;
  display: flex;
  flex: 1;
  flex-direction: column;
  justify-content: end;
  align-items: center;
  gap: 5px;
}

.la-bar {
  width: min(35px, 75%);
  max-height: 105px;
  min-height: 8px;
  border-radius: 5px 5px 0 0;
  background: linear-gradient(180deg, #70f0d8, #8252c5);
  transition: height .45s ease, filter .35s ease;
}

.la-bar-wrap span {
  color: #c3b5df;
  font-size: 9px;
}

.la-operation {
  display: flex;
  flex-direction: column;
  gap: 5px;
  padding: 9px 11px;
  border-left: 2px solid #67ead6;
  background: #1b1730;
}

.la-operation span,
.la-explanation > span {
  color: #a998c9;
  font-size: 8px;
  font-weight: bold;
  letter-spacing: 1.3px;
}

.la-operation strong {
  color: #82f0dc;
  font-size: 11px;
}

.la-explanation {
  margin-top: 10px;
}

.la-explanation p {
  margin: 5px 0 0;
  color: #c5b9dc;
  font-size: 10px;
  line-height: 1.55;
}

.la-timeline {
  height: 3px;
  margin-top: 12px;
  overflow: hidden;
  border-radius: 5px;
  background: #493961;
}

.la-timeline span {
  display: block;
  height: 100%;
  background: linear-gradient(90deg, #a56cff, #5df2d2);
  transition: width .35s ease;
}

.la-playing .la-array-cell.active,
.la-playing .la-node.active,
.la-playing .la-linked-node.active,
.la-playing .la-stack-item.active,
.la-playing .la-hash-step.active,
.la-playing .la-vertex.active {
  animation: laActivePulse 1.3s ease-in-out infinite alternate;
}

@keyframes laActivePulse {
  from { filter: brightness(1); }
  to { filter: brightness(1.55); }
}

@keyframes laBlink {
  from { opacity: .45; }
  to { opacity: 1; }
}

@media (max-width: 600px) {
  .lesson-animation {
    padding: 13px;
  }

  .la-array {
    gap: 5px;
  }

  .la-array-cell {
    min-width: 36px;
  }

  .la-flow {
    gap: 3px;
  }

  .la-node {
    padding: 9px 7px;
    font-size: 9px;
  }

  .la-linked-row {
    gap: 2px;
  }

  .la-linked-node {
    min-width: 32px;
    padding: 7px 3px;
  }

  .la-queue .la-stack {
    min-width: 0;
  }
}
