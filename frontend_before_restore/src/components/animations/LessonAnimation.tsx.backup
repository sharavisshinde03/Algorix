function ArrayVisual({ labels, active }: { labels: string[]; active: number }) {
  return (
    <div className="la-array">
      {labels.map((label, i) => (
        <div className={`la-array-cell ${i === active ? "active" : ""}`} key={`${label}-${i}`}>
          <strong>{label}</strong>
          <small>[{i}]</small>
        </div>
      ))}
    </div>
  );
}

function FlowVisual({ labels, active }: { labels: string[]; active: number }) {
  return (
    <div className="la-flow">
      {labels.map((label, i) => (
        <div className="la-flow-item" key={i}>
          <div className={`la-node ${i === active ? "active" : ""}`}>{label}</div>
          {i < labels.length - 1 && <span className="la-arrow">→</span>}
        </div>
      ))}
    </div>
  );
}

function LinkedVisual({ labels, active }: { labels: string[]; active: number }) {
  return (
    <div className="la-linked">
      <div className="la-pointer">HEAD ↓</div>
      <div className="la-linked-row">
        {labels.map((label, i) => (
          <div className="la-linked-group" key={i}>
            <div className={`la-linked-node ${i === active ? "active" : ""}`}>
              <strong>{label}</strong><small>data</small>
            </div>
            {i < labels.length - 1 && <span className="la-arrow">→</span>}
          </div>
        ))}
        <span className="la-null">NULL</span>
      </div>
      <div className="la-pointer">CURRENT ↑</div>
    </div>
  );
}

function StackVisual({ labels, active, queue = false }: {
  labels: string[]; active: number; queue?: boolean;
}) {
  return (
    <div className={`la-stack-wrap ${queue ? "la-queue" : ""}`}>
      <span>{queue ? "FRONT" : "TOP"}</span>
      <div className="la-stack">
        {labels.map((_, i) => {
          const index = queue ? i : labels.length - 1 - i;
          return (
            <div className={`la-stack-item ${index === active ? "active" : ""}`} key={i}>
              {labels[index]}
            </div>
          );
        })}
      </div>
      <span>{queue ? "REAR" : "BOTTOM"}</span>
    </div>
  );
}

function TreeVisual({ labels, active }: { labels: string[]; active: number }) {
  const positions = [
    [210, 25], [115, 95], [305, 95],
    [65, 160], [165, 160], [255, 160], [355, 160]
  ];
  const edges = [[0,1],[0,2],[1,3],[1,4],[2,5],[2,6]];
  return (
    <div className="la-tree">
      <svg viewBox="0 0 420 195" role="img" aria-label="Animated tree structure">
        {edges.map(([a,b], i) => (
          <line key={i}
            x1={positions[a][0]} y1={positions[a][1]}
            x2={positions[b][0]} y2={positions[b][1]}
            className="la-edge"
          />
        ))}
        {labels.slice(0,7).map((label, i) => (
          <g key={i}>
            <circle
              cx={positions[i][0]} cy={positions[i][1]} r="20"
              className={`la-vertex ${i === active ? "active" : ""}`}
            />
            <text x={positions[i][0]} y={positions[i][1] + 5}
              textAnchor="middle" className="la-vertex-label">{label}</text>
          </g>
        ))}
      </svg>
    </div>
  );
}

function GraphVisual({ labels, active }: { labels: string[]; active: number }) {
  const points = [[65,85],[180,30],[330,85],[180,150]];
  const edges = [[0,1],[1,2],[2,3],[3,0],[0,2]];
  return (
    <div className="la-graph">
      <svg viewBox="0 0 400 180" role="img" aria-label="Graph traversal">
        {edges.map(([a,b], i) => (
          <line key={i}
            x1={points[a][0]} y1={points[a][1]}
            x2={points[b][0]} y2={points[b][1]}
            className="la-edge"
          />
        ))}
        {points.map(([x,y], i) => (
          <g key={i}>
            <circle cx={x} cy={y} r="22"
              className={`la-vertex ${i === active % points.length ? "active" : ""}`} />
            <text x={x} y={y+5} textAnchor="middle" className="la-vertex-label">
              {labels[i] ?? "V"}
            </text>
          </g>
        ))}
      </svg>
    </div>
  );
}

function HashVisual({ labels, active }: { labels: string[]; active: number }) {
  return (
    <div className="la-hash">
      {labels.map((label, i) => (
        <div className={`la-hash-step ${i === active ? "active" : ""}`} key={i}>
          <span>{i + 1}</span><strong>{label}</strong>
        </div>
      ))}
    </div>
  );
}

function ChartVisual({ labels, active }: { labels: string[]; active: number }) {
  const heights = [42, 86, 62, 108, 72, 96, 55];
  return (
    <div className="la-chart">
      {labels.map((label, i) => (
        <div className="la-bar-wrap" key={i}>
          <div className={`la-bar ${i === active ? "active" : ""}`}
            style={{ height: heights[i % heights.length] }} />
          <span>{label}</span>
        </div>
      ))}
    </div>
  );
}

function SpecialVisual({ visual, active }: { visual: Visual; active: number }) {
  const labels = visual.labels;
  if (visual.kind === "array" || visual.kind === "select" || visual.kind === "segment") {
    return <ArrayVisual labels={labels} active={active % labels.length} />;
  }
  if (visual.kind === "linked") return <LinkedVisual labels={labels} active={active % labels.length} />;
  if (visual.kind === "stack") return <StackVisual labels={labels} active={active % labels.length} />;
  if (visual.kind === "queue") return <StackVisual labels={labels} active={active % labels.length} queue />;
  if (visual.kind === "tree" || visual.kind === "trie" || visual.kind === "dsu") {
    return <TreeVisual labels={labels} active={active % Math.min(labels.length, 7)} />;
  }
  if (visual.kind === "graph") return <GraphVisual labels={labels} active={active} />;
  if (visual.kind === "hash" || visual.kind === "bloom" || visual.kind === "kmp") {
    return <HashVisual labels={labels} active={active % labels.length} />;
  }
  if (visual.kind === "sort") return <ChartVisual labels={labels} active={active % labels.length} />;
  if (visual.kind === "dp" || visual.kind === "recursion") {
    return <FlowVisual labels={labels} active={active % labels.length} />;
  }
  if (visual.kind === "memory") return <ArrayVisual labels={labels} active={active % labels.length} />;
  return <FlowVisual labels={labels} active={active % labels.length} />;
}

export default function LessonAnimation({
  lessonId,
  lessonTitle,
  sceneIndex = 0,
  playing = false,
}: {
  lessonId: string;
  lessonTitle: string;
  sceneIndex?: number;
  playing?: boolean;
}) {
  const visual = visuals[lessonId] ?? make(
    lessonTitle,
    "Visual explanation",
    "flow",
    ["Input", "Process", "Output"],
    ["Receive input", "Process information", "Produce result"],
    "Follow how the concept transforms input into an output."
  );

  const active = Math.abs(sceneIndex) % visual.steps.length;

  return (
    <section
      className={`lesson-animation ${playing ? "la-playing" : ""} la-kind-${visual.kind}`}
      aria-label={`${lessonTitle} animated explanation`}
    >
      <div className="la-heading">
        <span className="la-live-dot" />
        <span>ANIMATED CONCEPT VISUALIZATION</span>
        <span className="la-step-count">
          {String(active + 1).padStart(2, "0")} / {String(visual.steps.length).padStart(2, "0")}
        </span>
      </div>

      <h3>{visual.title}</h3>
      <p className="la-subtitle">{visual.subtitle}</p>

      <div className="la-stage" key={`${lessonId}-${sceneIndex}`}>
        <SpecialVisual visual={visual} active={active} />
      </div>

      <div className="la-operation">
        <span>ACTIVE OPERATION</span>
        <strong>{visual.steps[active]}</strong>
      </div>

      <div className="la-explanation">
        <span>WHAT YOU ARE SEEING</span>
        <p>{visual.detail}</p>
      </div>

      <div className="la-timeline">
        <span style={{ width: `${((active + 1) / visual.steps.length) * 100}%` }} />
      </div>
    </section>
  );
}
