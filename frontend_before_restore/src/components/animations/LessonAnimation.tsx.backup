import "./LessonAnimation.css";

type Kind =
  | "flow" | "memory" | "array" | "linked"
  | "stack" | "queue" | "tree" | "graph"
  | "hash" | "sort" | "recursion" | "dp"
  | "trie" | "kmp" | "bloom" | "dsu"
  | "segment" | "select";

interface Visual {
  title: string;
  subtitle: string;
  kind: Kind;
  labels: string[];
  steps: string[];
  detail: string;
}

const make = (
  title: string,
  subtitle: string,
  kind: Kind,
  labels: string[],
  steps: string[],
  detail: string
): Visual => ({ title, subtitle, kind, labels, steps, detail });

